# Copy to ".env" (never commit .env). Placeholder values only.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins allowed to call the API (CORS) and to send CSRF-protected requests
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Set True (with DJANGO_DEBUG=True) to print every SQL statement Django runs
DJANGO_SQL_LOG=False

# --- PostgreSQL ---
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me-db-password
# "localhost" when Django runs on your machine, Compose overrides this to "db" inside containers
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Port published on your machine by docker compose (change if 5432 is taken)
POSTGRES_HOST_PORT=5432

# --- Sample data (only used by `manage.py seed_demo_data`) ---
SEED_PASSWORD=change-me-sample-account-password
